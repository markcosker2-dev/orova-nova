# HermesClaw / OROVA Environment Variables
# Copy this to .env and fill in values. Items marked [FREE] have free tiers.
# Items marked [OPTIONAL] work without a key (graceful fallback).

# ═══════════════════════════════════════════════════════════════
# CORE — Required for the app to start
# ═══════════════════════════════════════════════════════════════
SECRET_KEY=change-me-to-a-random-string
DASHBOARD_API_KEY=nova_admin_2026

# ═══════════════════════════════════════════════════════════════
# AI / LLM — At least one required for enrichment & copywriting
# ═══════════════════════════════════════════════════════════════
GROQ_API_KEY=              # [FREE] https://console.groq.com — primary LLM
GOOGLE_API_KEY=             # [FREE] https://aistudio.google.com — secondary LLM (Gemini)
OPENROUTER_API_KEY=         # [FREE TIER] https://openrouter.ai — tertiary LLM

# ═══════════════════════════════════════════════════════════════
# EMAIL OUTREACH — AgentMail (AI proofreading gate)
# ═══════════════════════════════════════════════════════════════
AGENTMAIL_API_KEY=          # https://agentmail.io — required for email outreach

# ═══════════════════════════════════════════════════════════════
# COLD CALLING — [OPTIONAL] Retell AI (graceful skip if missing)
# ═══════════════════════════════════════════════════════════════
RETELL_API_KEY=             # https://retellai.com — leave blank to skip calls
RETELL_FROM_NUMBER=         # Your Retell phone number (e.g. +1234567890)
RETELL_AGENT_ID=           # Your Retell agent ID

# ═══════════════════════════════════════════════════════════════
# GOOGLE SHEETS CRM — Required for lead sync
# ═══════════════════════════════════════════════════════════════
GOOGLE_CREDENTIALS_JSON=    # Path to service account JSON (e.g. credentials.json)

# ═══════════════════════════════════════════════════════════════
# TELEGRAM NOTIFICATIONS — [OPTIONAL] Real-time alerts
# ═══════════════════════════════════════════════════════════════
TELEGRAM_BOT_TOKEN=         # @BotFather — leave blank to skip Telegram alerts
PERSONAL_CHAT_ID=           # Your Telegram chat ID

# ═══════════════════════════════════════════════════════════════
# SCRAPING — [OPTIONAL] Enhanced enrichment sources
# ═══════════════════════════════════════════════════════════════
FIRECRAWL_API_KEY=          # [FREE TIER] https://firecrawl.dev — Yelp scraping
TAVILY_API_KEY=             # [FREE TIER] https://tavily.com — web search enrichment
APOLLO_API_KEY=             # [FREE TIER] https://apollo.io — contact enrichment
HUNTER_API_KEY=             # [FREE TIER] https://hunter.io — email finder

# ═══════════════════════════════════════════════════════════════
# WORKER TUNING — Autonomous lane configuration
# ═══════════════════════════════════════════════════════════════
MAX_CALLS_PER_DAY=5         # Safety cap for Retell calls
COLD_LEAD_DAYS_THRESHOLD=7  # Days before cold escalation
HINDSIGHT_API_LLM_MAX_CONCURRENT=1  # MUST be 1 — prevents Groq rate-limit storms

# ═══════════════════════════════════════════════════════════════
# SEMANTIC FIREWALL
# ═══════════════════════════════════════════════════════════════
SEMANTIC_FIREWALL_ENABLED=true
SEMANTIC_FIREWALL_LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════
# ELECTRON / DESKTOP BUILD — [OPTIONAL] Only for desktop app
# ═══════════════════════════════════════════════════════════════
OPENCLAW_GATEWAY_PORT=18789
OROVA_BACKEND_URL=http://127.0.0.1:18790
VITE_DEV_SERVER_PORT=5173

# Apple Developer Credentials (CI/CD only)
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
CSC_LINK=
CSC_KEY_PASSWORD=
GH_TOKEN=
