# Nova / OpenClaw — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git

# ── Nova Security ────────────────────────────────────────────────────────────
# The API key your dashboard uses to authenticate with the backend
# Generate one at: https://generate.plus/en/base64
NOVA_API_KEY=nova-change-this-to-something-secret

# ── Google AI (Gemini) ───────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ── Retell AI (Voice Calling) ────────────────────────────────────────────────
# Dashboard: https://app.retellai.com
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=+1XXXXXXXXXX      # Your Retell phone number (include country code)

# ── Email Outreach (Gmail) ───────────────────────────────────────────────────
# Use a dedicated outreach Gmail account, not your personal one
# Enable "App Passwords" in Google Account > Security (2FA must be on)
EMAIL_USER=your-outreach@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx       # 16-char Google App Password (not your login password)

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Create bot: message @BotFather on Telegram → /newbot
# Get chat ID: message @userinfobot after starting your bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                    # Your personal chat ID (integer)

# ── Google Sheets CRM / Drive ─────────────────────────────────────────────────
# Share the sheet with your service account email
GOOGLE_SHEETS_WORKBOOK=OROVA CRM
GOOGLE_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# ── Dashboard / Cron ─────────────────────────────────────────────────────────
DASHBOARD_API_KEY=change-this-to-something-secret
CRON_SECRET=change-this-to-something-secret

# ── Other AI Providers (optional, keep for future use) ───────────────────────
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── Render / Runtime ──────────────────────────────────────────────────────────
DATA_DIR=/data                          # Persistent directory for Render free tier
RENDER_EXTERNAL_URL=https://your-app.onrender.com
DATABASE_URL=sqlite+aiosqlite:///app/app/data/orova_v5.db
PORT=18789
