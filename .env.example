# HermesClaw Environment Variables

# OpenClaw Gateway Configuration
OPENCLAW_GATEWAY_PORT=18789

# OROVA Backend Configuration
OROVA_BACKEND_URL=http://127.0.0.1:18790
OROVA_API_KEY=nova_admin_2026

# Development Configuration
VITE_DEV_SERVER_PORT=5173

# Release Configuration (CI/CD)
# Apple Developer Credentials
APPLE_ID=your@email.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX

# Code Signing Certificate
CSC_LINK=path/to/certificate.p12
CSC_KEY_PASSWORD=certificate_password

# GitHub Token for releases
GH_TOKEN=github_personal_access_token

# Hermes Agent (Python) — LLM Slot Starvation Prevention
# MUST be set to 1. Higher values cause Groq rate-limit storms when
# multiple worker lanes fire simultaneously (e.g. Lane 1 every 2min
# + Lane 2 every 60min). Single-concurrent ensures FIFO queuing.
HINDSIGHT_API_LLM_MAX_CONCURRENT=1

# Semantic Firewall Configuration
SEMANTIC_FIREWALL_ENABLED=true
SEMANTIC_FIREWALL_LOG_LEVEL=info
