# OROVA Nova — Comprehensive Environment Variables Template
# Copy to .env and fill in all values for full production deployment.

# ==========================================
# AI Providers (Free-first fallback order)
# ==========================================

# Kilo Code MiMo v2 Pro (FREE — recommended first)
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.kilocode.ai/v1
MIMO_MODEL=MiMo/v2-pro

# OpenRouter (many free models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq (FREE tier, fast)
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google AI
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_PROJECT_ID=your_google_project_id_here

# ==========================================
# Telegram Configuration
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=your_admin_chat_id_here
PERSONAL_CHAT_ID=your_personal_chat_id_here
GROUP_CHAT_ID=your_group_chat_id_here

# ==========================================
# Retell AI (Voice Calls) - E.164 format required
# ==========================================
RETELL_API_KEY=your_retell_api_key_here
RETELL_AGENT_ID=your_retell_agent_id_here
RETELL_FROM_NUMBER=+12137774445  # Must be E.164 format

# ==========================================
# AgentMail (Nova's Email Inbox)
# ==========================================
AGENTMAIL_API_KEY=your_agentmail_api_key_here

# EMAIL_ACCOUNTS: JSON array for multi-domain rotation (Audit Fix)
# Format: [{"user":"nova@orova.co","pass":"xxxx","label":"orova.co"},...]
# If 'pass' is provided, SMTP (yagmail) is used. Otherwise, AgentMail API is used.
EMAIL_ACCOUNTS=[{"user":"your_email@domain.com","pass":"your_app_password","label":"domain.com"}]
EMAIL_DAILY_CAP=50

# ==========================================
# Google Services (Sheets, Drive)
# ==========================================
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
CRM_SHEET_ID=your_crm_sheet_id_here
DRIVE_FOLDER_ID=your_drive_folder_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email_here

# ==========================================
# Meta/Facebook Ads (SAGE)
# ==========================================
META_ACCESS_TOKEN=your_meta_access_token_here
META_AD_ACCOUNT_ID=act_XXXXXXXXXX
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# KPI Thresholds for Autonomous Ad Management (Audit Fix)
META_MAX_CPL=150.00
META_MIN_ROAS=2.0
META_MAX_FREQUENCY=4.0
META_MIN_CTR=0.5
META_EVALUATION_DAYS=3

# ==========================================
# Calling Hours Configuration
# ==========================================
CALLING_HOURS_START=09:00
CALLING_HOURS_END=18:00
CALLING_TIMEZONE=America/New_York

# ==========================================
# OROVA Mission Control Dashboard API Key
# ==========================================
OROVA_API_KEY=your_orova_api_key_here

# ==========================================
# Vertical/Client Configuration
# ==========================================
VERTICAL_NAME=LuxuryRemodeling
CLIENT_NAME=your_client_name_here
AGENCY_NAME=OROVA
CLIENT_CONFIG=your_client_specific_config_here

# ==========================================
# Server Settings
# ==========================================
PORT=7860
HOST=0.0.0.0
NODE_ENV=production
DEBUG=false
LOG_LEVEL=info

# ==========================================
# Oracle Cloud ARM64 Specific Configurations
# ==========================================
ORACLE_REGION=us-ashburn-1
ORACLE_COMPARTMENT_ID=your_oracle_compartment_id_here
ORACLE_TENANCY_ID=your_oracle_tenancy_id_here
ORACLE_USER_ID=your_oracle_user_id_here
ORACLE_FINGERPRINT=your_oracle_fingerprint_here
ORACLE_PRIVATE_KEY_PATH=/path/to/oracle_private_key.pem
ORACLE_AVAILABILITY_DOMAIN=your_availability_domain_here
ORACLE_SHAPE=VM.Standard.A1.Flex
ORACLE_OCPUS=2
ORACLE_MEMORY_IN_GBS=12
