[Unit]
Description=OROVA Autonomous Night Shift Worker
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/openclaw_v2
ExecStart=/home/ubuntu/openclaw_v2/venv/bin/python3 /home/ubuntu/openclaw_v2/app/worker.py
Restart=always
RestartSec=10
EnvironmentFile=/home/ubuntu/openclaw_v2/.env

[Install]
WantedBy=multi-user.target
