{
  "name": "OROVA Lead to Notion",
  "description": "Blueprint for Make.com to receive OROVA webhook leads and forward them into a Notion database.",
  "version": "1.0",
  "note": "This JSON is a documentation blueprint only. It is not a Make.com scenario export and cannot be imported directly into Make.",
  "steps": [
    {
      "step": 1,
      "action": "Create Custom Webhook",
      "module": "Webhooks > Custom Webhook",
      "notes": "Save and copy the webhook URL; this is the Make webhook to receive OROVA lead data."
    },
    {
      "step": 2,
      "action": "Add Filter",
      "module": "Filter",
      "notes": "Validate that the incoming field `secret` equals the configured OROVA_SECRET value."
    },
    {
      "step": 3,
      "action": "Create Notion Database Item",
      "module": "Notion > Create a database item",
      "notes": "Use the Notion integration token and the target database. Map incoming fields to Notion properties."
    }
  ],
  "webhook_payload_fields": {
    "id": "Unique lead ID",
    "business": "Business name",
    "owner": "Owner or lead contact",
    "email": "Email address",
    "phone": "Phone number",
    "website": "Website or landing page",
    "url": "Original lead source URL",
    "status": "Lead status, e.g. new",
    "score": "Numeric lead score",
    "notes": "Notes or summary",
    "source": "Source label, e.g. Nova Engine",
    "secret": "Shared webhook secret to authenticate the request"
  },
  "notion_mapping": {
    "Name": "business",
    "Owner": "owner",
    "Email": "email",
    "Phone": "phone",
    "Website": "website",
    "Status": "status",
    "Score": "score",
    "Notes": "notes",
    "Source": "source"
  },
  "notion_http_template": {
    "parent": { "database_id": "DATABASE_ID" },
    "properties": {
      "Name": {
        "title": [
          { "text": { "content": "{{business}}" } }
        ]
      },
      "Owner": { "rich_text": [ { "text": { "content": "{{owner}}" } } ] },
      "Email": { "rich_text": [ { "text": { "content": "{{email}}" } } ] },
      "Phone": { "rich_text": [ { "text": { "content": "{{phone}}" } } ] },
      "Website": { "url": "{{website}}" },
      "Status": { "select": { "name": "{{status}}" } },
      "Score": { "number": {{score}} },
      "Notes": { "rich_text": [ { "text": { "content": "{{notes}}" } } ] },
      "Source": { "rich_text": [ { "text": { "content": "{{source}}" } } ] }
    }
  },
  "sample_payload": {
    "id": "lead_12345",
    "business": "Acme Remodeling Co",
    "owner": "Jane Doe",
    "email": "jane.doe@acme.com",
    "phone": "+1-555-123-4567",
    "website": "https://acme.example.com",
    "url": "https://acme.example.com/contact",
    "status": "new",
    "score": 85,
    "notes": "Requested pricing for a full kitchen remodel. Prefers email contact.",
    "source": "Nova Engine",
    "secret": "REPLACE_WITH_OROVA_SECRET"
  }
}
